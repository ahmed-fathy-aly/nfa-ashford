<div class="container">
    <!-- Eurostar Countdown -->
    <div class="eurostar-countdown">
        <div class="countdown-display">
            <div class="countdown-item">
                <div class="flip-card">
                    <span class="countdown-value" id="years">0</span>
                </div>
                <span class="countdown-label">Years</span>
            </div>
            <div class="countdown-item">
                <div class="flip-card">
                    <span class="countdown-value" id="months">0</span>
                </div>
                <span class="countdown-label">Months</span>
            </div>
            <div class="countdown-item">
                <div class="flip-card">
                    <span class="countdown-value" id="days">0</span>
                </div>
                <span class="countdown-label">Days</span>
            </div>
        </div>
        <div class="countdown-header">
            <h2 class="countdown-title">since the last Eurostar from Ashford International</h2>
        </div>
        <div class="countdown-cta">
            <p class="cta-text">Help bring back international rail services to Ashford</p>
            <a href="https://www.change.org/p/bring-back-eurostar-train-services-to-kent" target="_blank" rel="noopener noreferrer" class="petition-button">
                Sign Petition
                <svg class="arrow-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>
    </div>

    <h2 class="page-title">Latest Articles</h2>
    <div class="articles-grid">
        <% articles.forEach(article => { %>
            <article class="article-card">
                <a href="/article/<%= article.id %>" class="article-link">
                    <div class="article-image">
                        <img src="<%= article.image %>" alt="<%= article.title %>">
                        <div class="article-tags">
                            <% article.tags.forEach(tag => { %>
                                <span class="tag"><%= tag %></span>
                            <% }); %>
                        </div>
                    </div>
                    <div class="article-content">
                        <div class="article-meta">
                            <time class="article-date"><%= new Date(article.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></time>
                        </div>
                        <h3 class="article-title"><%= article.title %></h3>
                        <p class="article-excerpt"><%= article.excerpt %></p>
                        <span class="read-more">
                            Read more
                            <svg class="read-more-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    </div>
                </a>
            </article>
        <% }); %>
    </div>
</div>

<script>
(function() {
    // Calculate time since March 18, 2020, 4:00 PM
    function updateCountdown() {
        const yearsEl = document.getElementById('years');
        const monthsEl = document.getElementById('months');
        const daysEl = document.getElementById('days');
        
        // Check if elements exist
        if (!yearsEl || !monthsEl || !daysEl) {
            console.log('Countdown elements not found, retrying in 50ms...');
            setTimeout(updateCountdown, 50);
            return;
        }
        
        const eurostarEnd = new Date('2020-03-18T16:00:00');
        const now = new Date();
        
        let years = now.getFullYear() - eurostarEnd.getFullYear();
        let months = now.getMonth() - eurostarEnd.getMonth();
        let days = now.getDate() - eurostarEnd.getDate();
        
        if (days < 0) {
            months--;
            const lastMonth = new Date(now.getFullYear(), now.getMonth(), 0);
            days += lastMonth.getDate();
        }
        
        if (months < 0) {
            years--;
            months += 12;
        }
        
        console.log('Final countdown values:', { years, months, days });
        
        // Check if animation has already played in this session
        const hasAnimationPlayed = sessionStorage.getItem('countdownAnimationPlayed');
        
        if (hasAnimationPlayed) {
            // Just set the values directly without animation
            yearsEl.textContent = String(years).padStart(2, '0');
            monthsEl.textContent = String(months).padStart(2, '0');
            daysEl.textContent = String(days).padStart(2, '0');
            
            // Remove animation class to prevent CSS animation
            yearsEl.style.animation = 'none';
            monthsEl.style.animation = 'none';
            daysEl.style.animation = 'none';
            return;
        }
        
        // Mark that animation has played
        sessionStorage.setItem('countdownAnimationPlayed', 'true');
        
        // Animate the numbers flipping with changing values
        function animateCounter(element, finalValue, duration, delay) {
            setTimeout(() => {
                const startTime = Date.now();
                const maxValue = Math.max(finalValue * 2, 20); // Show higher numbers for effect
                
                function updateNumber() {
                    const elapsed = Date.now() - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    
                    if (progress < 1) {
                        // Generate random-ish numbers that gradually approach the final value
                        const range = maxValue - finalValue;
                        const currentRange = range * (1 - progress);
                        const randomValue = Math.floor(finalValue + Math.random() * currentRange);
                        element.textContent = String(randomValue).padStart(2, '0');
                        
                        // Sync with flip animation - update every ~100ms during flips
                        setTimeout(updateNumber, 100);
                    } else {
                        // Set final value with leading zero
                        element.textContent = String(finalValue).padStart(2, '0');
                    }
                }
                
                updateNumber();
            }, delay);
        }
        
        // Animate each counter with staggered delays matching the CSS animation
        animateCounter(yearsEl, years, 2000, 0);
        animateCounter(monthsEl, months, 2000, 200);
        animateCounter(daysEl, days, 2000, 400);
    }
    
    // Start immediately
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateCountdown);
    } else {
        updateCountdown();
    }
    
    // Update daily
    setInterval(updateCountdown, 86400000);
})();
</script>
