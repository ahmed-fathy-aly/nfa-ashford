<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Normal For Ashford</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="header">
        <nav class="nav">
            <div class="nav-container">
                <a href="/" class="nav-logo">Normal For Ashford</a>
                <ul class="nav-menu">
                    <li class="nav-item">
                        <a href="/" class="nav-link active">Home</a>
                    </li>
                    <li class="nav-item">
                        <a href="/about" class="nav-link">About</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="main-content">
        <div class="container">
            <h1 class="page-title">Latest Articles</h1>
            
            <div class="articles-grid">
                <% articles.forEach(article => { %>
                    <article class="article-card">
                        <a href="/article/<%= article.id %>" class="article-link">
                            <div class="card-image-container">
                                <img src="<%= article.image %>" alt="<%= article.title %>" class="card-image" loading="lazy">
                                <div class="card-tags">
                                    <% article.tags.forEach(tag => { %>
                                        <span class="tag"><%= tag %></span>
                                    <% }); %>
                                </div>
                            </div>
                            <div class="article-content">
                                <h2 class="article-title"><%= article.title %></h2>
                                <p class="article-excerpt"><%= article.excerpt %></p>
                                <time class="article-date" datetime="<%= article.date %>">
                                    <%= new Date(article.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                </time>
                            </div>
                        </a>
                    </article>
                <% }); %>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-container">
            <p>&copy; <%= new Date().getFullYear() %> Normal For Ashford. All rights reserved.</p>
        </div>
    </footer>

    <script>
        let lastScrollTop = 0;
        const header = document.querySelector('.header');
        const scrollThreshold = 100;
        
        window.addEventListener('scroll', function() {
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            
            if (scrollTop > scrollThreshold) {
                if (scrollTop > lastScrollTop) {
                    // Scrolling down
                    header.classList.add('header-hidden');
                    header.classList.remove('header-visible');
                } else {
                    // Scrolling up
                    header.classList.remove('header-hidden');
                    header.classList.add('header-visible');
                }
            } else {
                // At top of page
                header.classList.remove('header-hidden');
                header.classList.add('header-visible');
            }
            
            lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        }, false);
    </script>
</body>
</html>