<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Normal For Ashford</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="header">
        <div class="nav-container">
            <a href="/" class="nav-logo">Normal For Ashford</a>
            <nav>
                <ul class="nav-menu">
                    <li class="nav-item">
                        <a href="/" class="nav-link active">Home</a>
                    </li>
                    <li class="nav-item">
                        <a href="/about" class="nav-link">About</a>
                    </li>
                </ul>
            </nav>
        </div>
        <div class="header-skyline">
            <svg viewBox="0 0 1440 120" fill="currentColor">
                <path d="M0,120 L240,80 L480,100 L720,60 L960,110 L1200,90 L1440,120 L1440,120 L0,120 Z" transform="translate(0, 5)"></path>
                <path d="M0,120 L120,100 L240,110 L360,90 L480,100 L600,80 L720,95 L840,70 L960,85 L1080,60 L1200,75 L1320,50 L1440,65 L1440,120 L0,120 Z" opacity="0.5"></path>
            </svg>
        </div>
    </header>

    <main class="main-content">
        <div class="container">
            <!-- Eurostar Countdown -->
            <div class="eurostar-countdown">
                <div class="countdown-header">
                    <h2 class="countdown-title">Last Eurostar from Ashford International</h2>
                    <p class="countdown-subtitle">Final service departed: March 18, 2020</p>
                </div>
                <div class="countdown-display">
                    <div class="countdown-item">
                        <span class="countdown-value" id="years">0</span>
                        <span class="countdown-label">Years</span>
                    </div>
                    <div class="countdown-item">
                        <span class="countdown-value" id="months">0</span>
                        <span class="countdown-label">Months</span>
                    </div>
                    <div class="countdown-item">
                        <span class="countdown-value" id="days">0</span>
                        <span class="countdown-label">Days</span>
                    </div>
                </div>
            </div>

            <h1 class="page-title">Latest Articles</h1>
            
            <div class="articles-grid">
                <% articles.forEach(article => { %>
                    <article class="article-card">
                        <a href="/article/<%= article.id %>" class="article-link">
                            <div class="card-image-container">
                                <img src="<%= article.image %>" alt="<%= article.title %>" class="card-image" loading="lazy">
                                <div class="card-tags">
                                    <% article.tags.forEach(tag => { %>
                                        <span class="tag"><%= tag %></span>
                                    <% }); %>
                                </div>
                            </div>
                            <div class="article-content">
                                <h2 class="article-title"><%= article.title %></h2>
                                <p class="article-excerpt"><%= article.excerpt %></p>
                                <time class="article-date" datetime="<%= article.date %>">
                                    <%= new Date(article.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                </time>
                            </div>
                        </a>
                    </article>
                <% }); %>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-container">
            <p>&copy; <%= new Date().getFullYear() %> Normal For Ashford. All rights reserved.</p>
        </div>
    </footer>

    <script>
        let lastScrollTop = 0;
        const header = document.querySelector('.header');
        const scrollThreshold = 100;
        
        window.addEventListener('scroll', function() {
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            
            if (scrollTop > scrollThreshold) {
                if (scrollTop > lastScrollTop) {
                    // Scrolling down
                    header.classList.add('header-hidden');
                    header.classList.remove('header-visible');
                } else {
                    // Scrolling up
                    header.classList.remove('header-hidden');
                    header.classList.add('header-visible');
                }
            } else {
                // At top of page
                header.classList.remove('header-hidden');
                header.classList.add('header-visible');
            }
            
            lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        }, false);

        // Eurostar Countdown
        function updateCountdown() {
            const lastEurostar = new Date('2020-03-18T16:00:00'); // Afternoon of March 18, 2020
            const now = new Date();
            
            let years = now.getFullYear() - lastEurostar.getFullYear();
            let months = now.getMonth() - lastEurostar.getMonth();
            let days = now.getDate() - lastEurostar.getDate();
            
            // Adjust for negative days
            if (days < 0) {
                months--;
                const lastMonth = new Date(now.getFullYear(), now.getMonth(), 0);
                days += lastMonth.getDate();
            }
            
            // Adjust for negative months
            if (months < 0) {
                years--;
                months += 12;
            }
            
            document.getElementById('years').textContent = years;
            document.getElementById('months').textContent = months;
            document.getElementById('days').textContent = days;
        }
        
        // Update countdown immediately and every hour
        updateCountdown();
        setInterval(updateCountdown, 3600000); // Update every hour
    </script>
</body>
</html>